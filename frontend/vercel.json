{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://snip-production-fbd2.up.railway.app/api/:path*"
    },
    {
      "source": "/go/:alias",
      "destination": "https://snip-production-fbd2.up.railway.app/go/:alias"
    },
    {
      "source": "/:alias([a-zA-Z0-9_-]{6})",
      "destination": "https://snip-production-fbd2.up.railway.app/:alias"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }]
    },
    {
      "source": "/go/:alias",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }]
    },
    {
      "source": "/:alias([a-zA-Z0-9_-]{6})",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }]
    }
  ]
}
